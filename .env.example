# Copy this file to .env and fill in the values. Never commit .env.
# Secret values stay empty in this template.
GEMINI_API_KEY=
HUNTER_API_KEY=
RESEND_API_KEY=
# OWNER_EMAIL must equal the email address of the Resend account, because onboarding@resend.dev only delivers there.
OWNER_EMAIL=
GEMINI_MODEL_SMART=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
HUNTER_MONTHLY_BUDGET=25
RESEND_FROM=onboarding@resend.dev
# SKELETON_DOMAIN is the one company domain used by the walking skeleton and by the smoke test's single Hunter search.
SKELETON_DOMAIN=
