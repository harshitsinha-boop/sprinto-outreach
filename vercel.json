{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "web",
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{src,config}/**"
    }
  },
  "rewrites": [
    { "source": "/index.html", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
